[Unit]
Description=Wyoming Satellite (Arduino UNO Q voice)
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
# Adjust User and paths to match where you cloned the repo.
User=arduino
WorkingDirectory=/home/arduino/arduino-unoq-home-assistant
ExecStart=/home/arduino/arduino-unoq-home-assistant/wyoming-satellite/run.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
