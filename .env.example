# ---------------------------------------------------------------------------
# Arduino UNO Q — Home Assistant voice hub configuration
# Copy to .env and edit.  `docker compose` reads this automatically.
# ---------------------------------------------------------------------------

# Timezone (see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=Europe/Dublin

# --- Speech models -----------------------------------------------------------
# Whisper STT model. tiny-int8 / base-int8 are good on the UNO Q.
WHISPER_MODEL=tiny-int8

# Piper TTS voice (https://github.com/rhasspy/piper/blob/master/VOICES.md)
PIPER_VOICE=en_GB-alba-medium

# openWakeWord wake word. Built‑ins: ok_nabu, hey_jarvis, alexa, hey_mycroft.
WAKEWORD=ok_nabu

# --- Audio devices (used by the native wyoming-satellite) --------------------
# Run ./scripts/setup-audio.sh to discover these names.
#
# Capture device (ALSA). Example for a USB mic:  plughw:CARD=Device,DEV=0
MIC_DEVICE=plughw:CARD=Device,DEV=0

# Playback: choose ONE style and put it in SND_COMMAND.
#
#   USB / analog speaker (ALSA):
#     SND_COMMAND=aplay -D plughw:CARD=Device,DEV=0 -r 22050 -c 1 -f S16_LE -t raw
#
#   Bluetooth speaker (via PulseAudio/PipeWire — see scripts/pair-bluetooth-speaker.sh):
#     SND_COMMAND=paplay --raw --rate=22050 --channels=1 --format=s16le --device=@DEFAULT_SINK@
#
#   Wi‑Fi speaker handled by Home Assistant instead of the satellite:
#     SND_COMMAND=
#
SND_COMMAND=aplay -D plughw:CARD=Device,DEV=0 -r 22050 -c 1 -f S16_LE -t raw

# --- Optional USB camera -----------------------------------------------------
CAMERA_DEVICE=/dev/video0
